# Copy to keystore.properties (gitignored) and fill in before a release build.
# Generate the keystore once and back it up securely — losing it means you can
# never update the app on Play (unless Play App Signing key rotation is set up).
#
#   keytool -genkey -v -keystore pemberley-upload.jks \
#     -alias pemberley -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=pemberley-upload.jks
storePassword=CHANGE_ME
keyAlias=pemberley
keyPassword=CHANGE_ME
